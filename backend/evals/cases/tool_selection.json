[
  {
    "id": "tool_selection.large_product_reaches_for_calculator",
    "family": "tool_selection",
    "turns": [
      {
        "prompt": "What is 739,481 multiplied by 52,967? I need the exact figure."
      }
    ],
    "run": {
      "enabled_tools": [
        "calculator",
        "whoami"
      ],
      "enabled_skills": []
    },
    "expect": {
      "contains_any": [
        "39,168,090,127",
        "39168090127"
      ],
      "tools": {
        "must_call": [
          "calculator"
        ],
        "must_not_call": [
          "whoami"
        ]
      }
    },
    "notes": "Six-by-five digit product. Replaces a five-by-three product that a thinking model works out by hand, correctly and without the tool (Haiku 5.5 on dev, 2026-11-04, every sample). At this size hand arithmetic is error-prone for any model, so the calculator is the right reach whether or not the model thinks first.",
    "judge": {
      "evaluators": [
        "tool_selection"
      ]
    }
  },
  {
    "id": "tool_selection.irrational_square_root_reaches_for_calculator",
    "family": "tool_selection",
    "turns": [
      {
        "prompt": "What is the square root of 87,341, to six decimal places?"
      }
    ],
    "run": {
      "enabled_tools": [
        "calculator"
      ],
      "enabled_skills": []
    },
    "expect": {
      "contains_any": [
        "295.535108",
        "295.5351079"
      ],
      "tools": {
        "must_call": [
          "calculator"
        ]
      }
    },
    "notes": "Irrational root to six places (295.5351078975...). Replaces the perfect square 7,569, whose root a thinking model checks by squaring 87 in its head (Haiku 5.5, 2026-11-04). Accepts the rounded value or a longer correct prefix, so printing the calculator's extra digits is not a failure.",
    "judge": {
      "evaluators": [
        "tool_selection"
      ]
    }
  },
