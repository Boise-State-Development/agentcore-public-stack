[
  {
    "id": "tool_selection.multiplication_reaches_for_calculator",
    "family": "tool_selection",
    "turns": [
      {
        "prompt": "What is 48,217 multiplied by 913? I need the exact figure."
      }
    ],
    "run": {
      "enabled_tools": [
        "calculator",
        "whoami"
      ],
      "enabled_skills": []
    },
    "expect": {
      "contains_any": [
        "44,022,121"
      ],
      "tools": {
        "must_call": [
          "calculator"
        ],
        "must_not_call": [
          "whoami"
        ]
      }
    },
    "notes": "Exact five-by-three digit product: a model that answers from memory is often wrong, so the calculator is the right tool."
  },
