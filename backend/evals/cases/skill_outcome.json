[
  {
    "id": "skill_outcome.web_research_cites_each_point",
    "family": "skill_outcome",
    "turns": [
      {
        "prompt": "Fetch https://example.com and write two short notes about it, each citing the page title and URL."
      }
    ],
    "run": {
      "enabled_tools": [
        "fetch_url_content"
      ],
      "enabled_skills": [
        "web_research",
        "skill_creator"
      ]
    },
    "expect": {
      "skill": {
        "loads": [
          "web_research"
        ]
      },
      "regex": {
        "search": [
          "https?://(www\\.)?example\\.com"
        ]
      },
      "contains_any": [
        "Example Domain"
      ]
    },
    "judge": {
      "evaluators": [
        "skill_following"
      ]
    },
    "notes": "web_research's rule: every note carries its source's title and URL."
  },
