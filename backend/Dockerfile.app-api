# Multi-stage build for App API
# Pin base image to digest for reproducible builds
FROM python:3.13-slim@sha256:739e7213785e88c0f702dcdc12c0973afcbd606dbf021a589cab77d6b00b579d AS builder

# Install uv (pinned to specific version for reproducibility)
COPY --from=ghcr.io/astral-sh/uv:0.7.12 /uv /uvx /bin/

# Set working directory
WORKDIR /app

# Compile every installed package to bytecode at build time. uv skips this by
# default, so the venv shipped with no .pyc files and every task that started
# from this image parsed the whole dependency tree (fastapi, boto3, strands,
# ...) on its first request. Unlike inference-api this is a long-lived ECS
# service, so the cost is paid per task start — deploys, scale-out, and Fargate
# task replacement — not per session. The final stage ships /app/.venv and
# /app/src root-owned, so the runtime user cannot write .pyc at all: baking them
# in at build time is the only place the bytecode can live.
ENV UV_COMPILE_BYTECODE=1

# Install system dependencies needed for any native builds
RUN apt-get update && apt-get install -y \
    gcc=4:14.2.0-1 \
    g++=4:14.2.0-1 \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files first (layer caching — deps change less often than code)
COPY backend/pyproject.toml backend/README.md ./
COPY backend/uv.lock ./

# Install dependencies only (not the project itself) from the locked versions
# --frozen: use the lock file as-is, no network resolution, pure replay
# --extra agentcore: include the agentcore optional dependency group (strands, etc.)
# --no-install-project: install deps only, skip the project package
# --no-dev: exclude development dependencies
# --no-editable: non-editable install for production
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --extra agentcore --no-install-project --no-dev --no-editable

# Copy source code and install the project itself
COPY backend/src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --extra agentcore --no-dev --no-editable

# Production stage
FROM python:3.13-slim@sha256:739e7213785e88c0f702dcdc12c0973afcbd606dbf021a589cab77d6b00b579d

WORKDIR /app

# Install runtime dependencies (curl required for HEALTHCHECK)
RUN apt-get update && apt-get install -y \
    curl=8.14.1-2+deb13u* \
    && rm -rf /var/lib/apt/lists/*

# Create the non-root user up front so the writable directory below can be
# handed to it without a recursive chown. A trailing `chown -R appuser /app`
# rewrites every file it touches into a fresh layer, so /app used to ship TWICE
# — 313MB of duplicate before this image carried bytecode, 454MB after.
RUN useradd -m -u 1000 -s /bin/bash appuser

# Code and dependencies ship ROOT-OWNED. appuser can read and execute them and
# cannot modify them, so a process that is compromised at runtime cannot
# rewrite its own source or drop a backdoor into site-packages.
#
# This is only possible because nothing writes into the source tree any more.
# It used to: main.py resolved base_dir from __file__ (landing in /app/src/apis)
# and os.makedirs() there on every startup, and agents/utils/config.py did the
# same one level up. Both now go through apis/shared/runtime_paths.py and the
# RUNTIME_DATA_DIR below. backend/tests/architecture/test_source_tree_not_written.py
# is the regression guard — if it fails, this image stops booting.
COPY --from=builder /app/.venv /app/.venv
COPY backend/src /app/src

# Precompile our own source the same way the venv was (see UV_COMPILE_BYTECODE
# above). `-q` keeps the layer log quiet; a syntax error still fails the build,
# which is the right time to learn about it. Runs as root, before USER, because
# /app/src is no longer writable by appuser — which is the point: the .pyc are
# baked now and can never be rewritten at runtime.
RUN python -m compileall -q /app/src

# The ONE writable location. Everything the services create at runtime (the
# static output/uploads/generated_images dirs, and the agents package's
# per-session tool output) resolves under here via RUNTIME_DATA_DIR.
ENV RUNTIME_DATA_DIR=/app/var
RUN install -d -o appuser -g appuser /app/var

# Switch to non-root user
USER appuser

# Version injection (defaults to "unknown" if not provided via --build-arg)
ARG APP_VERSION=unknown
ENV APP_VERSION=${APP_VERSION}

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src
ENV PATH="/app/.venv/bin:$PATH"

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the application
CMD ["uvicorn", "apis.app_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
